---
import { site, waLink, u } from "../data/site";
import { categoriiInfo } from "../data/bijuterii";
import IconWa from "./IconWa.astro";
---

<footer class="bg-[#161616] text-[0.92rem] text-white/80">
  <div class="wrap grid gap-8 py-10 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="text-xl font-black text-white">PROBA <span class="bg-gold-bright px-1.5 text-[#151515]">585</span></p>
      <p class="mt-3">Bijuterii din aur de 14K: noi la comandă, din amanet și recondiționate. Cumpărăm aur de la persoane fizice.</p>
    </div>
    <div>
      <h2 class="text-base text-white">Bijuterii</h2>
      <ul class="mt-3 space-y-1.5">
        {Object.entries(categoriiInfo).map(([k, v]) => <li><a href={u(`/bijuterii?categorie=${k}`)} class="hover:text-gold-bright">{v}</a></li>)}
      </ul>
    </div>
    <div>
      <h2 class="text-base text-white">Informații</h2>
      <ul class="mt-3 space-y-1.5">
        <li><a href={u("/bijuterii?provenienta=amanet")} class="hover:text-gold-bright">Bijuterii din amanet</a></li>
        <li><a href={u("/la-comanda")} class="hover:text-gold-bright">Bijuterii la comandă</a></li>
        <li><a href={u("/cumparam-aur")} class="hover:text-gold-bright">Cumpărăm aur</a></li>
        <li><a href={u("/contact")} class="hover:text-gold-bright">Contact</a></li>
      </ul>
    </div>
    <div>
      <h2 class="text-base text-white">Contact</h2>
      <a href={`tel:${site.telefon}`} class="mt-3 block text-xl font-bold text-white no-underline hover:text-gold-bright">{site.telefonAfisat}</a>
      <ul class="mt-2 space-y-1">
        {site.program.map((p) => <li class="flex max-w-52 justify-between gap-4"><span>{p.zi}</span><span>{p.ore}</span></li>)}
      </ul>
      <p class="mt-3 text-white/60">Lucrăm prin WhatsApp și curier. Sediul este în pregătire.</p>
    </div>
  </div>
  <div class="border-t border-white/15">
    <p class="wrap py-4 text-[0.82rem] text-white/55">© {new Date().getFullYear()} {site.nume}. Prețurile afișate sunt orientative și se confirmă la cântărire.</p>
  </div>
</footer>

<div class="plutitoare">
  <a href={`tel:${site.telefon}`} class="rotund bg-red" aria-label={`Sunați la ${site.telefonAfisat}`}>
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25c1.1.37 2.3.57 3.6.57a1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1L6.6 10.8Z"/></svg>
  </a>
  <a href={waLink("Bună ziua!")} target="_blank" rel="noopener" class="rotund bg-wa" aria-label="Scrieți pe WhatsApp">
    <IconWa size={30} />
  </a>
</div>

<style>
  .plutitoare { position: fixed; right: 1rem; bottom: 1rem; z-index: 50; display: grid; gap: 0.6rem; }
  .rotund { display: grid; place-items: center; width: 3.4rem; height: 3.4rem; border-radius: 50%; color: #fff; box-shadow: 0 3px 10px rgb(0 0 0 / 0.3); }
  .rotund:hover { filter: brightness(1.08); }
</style>
