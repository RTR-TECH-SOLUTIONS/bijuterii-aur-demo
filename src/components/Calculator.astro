---
import { preturi, site } from "../data/site";
import IconWa from "./IconWa.astro";

interface Props { peInchis?: boolean }
const { peInchis = false } = Astro.props;
---

<form
  id="calculator"
  class:list={["rounded-(--radius-box) p-6 md:p-7", peInchis ? "bg-white text-ink" : "border border-line bg-white"]}
  data-wa={site.whatsapp}
>
  <h3 class="!text-[1.25rem]">Cât primiți pe aurul dumneavoastră</h3>
  <p class="mt-1.5 text-[0.95rem] text-ink-soft">Estimare după greutate și titlu. Suma finală se stabilește la cântărire.</p>

  <div class="mt-5 grid gap-4 sm:grid-cols-2">
    <label class="block">
      <span class="mb-1.5 block text-[0.95rem] font-medium">Greutate, în grame</span>
      <input class="camp cifra" id="calc-grame" type="number" inputmode="decimal" min="0.1" step="0.01" value="5" />
    </label>
    <label class="block">
      <span class="mb-1.5 block text-[0.95rem] font-medium">Titlul aurului</span>
      <select class="camp" id="calc-carat">
        {preturi.cumparare.map((p) => (
          <option value={p.leiGram} data-carat={p.carat} selected={p.carat === "14K"}>{p.carat} (marcaj {p.titlu})</option>
        ))}
      </select>
    </label>
  </div>

  <div class="mt-5 flex items-end justify-between gap-4 border-t border-line pt-4">
    <p class="text-[0.95rem] text-ink-soft" id="calc-detaliu" aria-hidden="true"></p>
    <p class="text-right"><span class="block text-[0.85rem] text-ink-soft">Estimare</span>
      <output id="calc-suma" for="calc-grame calc-carat" class="text-[2rem] font-black leading-none" aria-live="polite"></output>
    </p>
  </div>

  <a id="calc-wa" href="#" target="_blank" rel="noopener" class="btn btn-wa mt-5 w-full">
    <IconWa /> Trimiteți estimarea pe WhatsApp
  </a>
</form>

<script>
  const f = document.getElementById("calculator") as HTMLFormElement | null;
  if (f) {
    const g = f.querySelector<HTMLInputElement>("#calc-grame")!;
    const c = f.querySelector<HTMLSelectElement>("#calc-carat")!;
    const suma = f.querySelector<HTMLOutputElement>("#calc-suma")!;
    const detaliu = f.querySelector<HTMLElement>("#calc-detaliu")!;
    const wa = f.querySelector<HTMLAnchorElement>("#calc-wa")!;
    const nr = new Intl.NumberFormat("ro-RO", { maximumFractionDigits: 0 });
    const calc = () => {
      const grame = Math.max(0, parseFloat(g.value.replace(",", ".")) || 0);
      const pret = Number(c.value);
      const carat = c.selectedOptions[0].dataset.carat;
      const total = Math.round(grame * pret);
      const gTxt = String(grame).replace(".", ",");
      suma.textContent = `${nr.format(total)} lei`;
      detaliu.textContent = `${gTxt} g × ${pret} lei/g`;
      // TODO(real): numărul de WhatsApp vine din setările site-ului
      wa.href = `https://wa.me/${f.dataset.wa}?text=${encodeURIComponent(
        `Bună ziua! Am aur de ${carat}, aproximativ ${gTxt} g. Pe site estimarea este ${nr.format(total)} lei. Vă pot trimite poze?`
      )}`;
    };
    g.addEventListener("input", calc);
    c.addEventListener("change", calc);
    f.addEventListener("submit", (e) => e.preventDefault());
    calc();
  }
</script>
