---
import { site, waLink, preturi, u } from "../data/site";
import { categoriiInfo } from "../data/bijuterii";
import IconWa from "./IconWa.astro";

const meniu = [
  { href: u("/"), label: "Acasă" },
  ...Object.entries(categoriiInfo).map(([k, v]) => ({ href: u(`/bijuterii?categorie=${k}`), label: v })),
  { href: u("/la-comanda"), label: "La comandă" },
  { href: u("/cumparam-aur"), label: "Cumpărăm aur" },
  { href: u("/contact"), label: "Contact" },
];
---

<div class="bg-black text-white text-[0.82rem] font-medium">
  <ul class="wrap flex items-center justify-center gap-x-8 py-2 md:justify-between">
    <li class="flex items-center gap-2"><span class="bifa" aria-hidden="true"></span>Marcaj 585 pe fiecare piesă</li>
    <li class="hidden items-center gap-2 sm:flex"><span class="bifa" aria-hidden="true"></span>Cântărire la 0,01 g</li>
    <li class="hidden items-center gap-2 md:flex"><span class="bifa" aria-hidden="true"></span>Verificare la primirea coletului</li>
    <li class="hidden items-center gap-2 lg:flex"><span class="bifa" aria-hidden="true"></span>Bon sau factură fiscală</li>
  </ul>
</div>

<div class="bg-white">
  <div class="wrap flex items-center gap-4 py-3 md:gap-8 md:py-4">
    <a href={u("/")} class="logo" aria-label={`${site.nume}, prima pagină`}>
      <span class="logo-nume">PROBA</span><span class="logo-marcaj">585</span>
      <span class="logo-sub">bijuterii aur 14K · amanet</span>
    </a>

    <form action={u("/bijuterii")} method="get" role="search" class="hidden flex-1 md:flex">
      <label class="sr-only" for="cauta">Căutați o bijuterie</label>
      <input id="cauta" name="q" type="search" placeholder="Căutați: inel, lanț, verighete…" class="camp !rounded-r-none !border-r-0 !bg-[#f3f3f1]" />
      <button class="btn btn-ink !rounded-l-none" type="submit">Caută</button>
    </form>

    <div class="ml-auto flex items-center gap-2 md:gap-5">
      <a href={`tel:${site.telefon}`} class="hidden text-right leading-tight no-underline lg:block">
        <span class="block text-[0.78rem] text-ink-soft">Sunați-ne</span>
        <span class="block text-[1.15rem] font-bold">{site.telefonAfisat}</span>
      </a>
      <a href={waLink("Bună ziua! Am văzut site-ul și aș dori câteva detalii.")} class="btn btn-wa" target="_blank" rel="noopener">
        <IconWa size={18} /> WhatsApp
      </a>
      <button id="meniu-btn" type="button" class="grid h-11 w-11 place-items-center rounded-(--radius-btn) border border-[#bdbab2] lg:hidden" aria-expanded="false" aria-controls="meniu">
        <span class="sr-only">Deschide meniul</span>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
</div>

<nav id="meniu" class="meniu sticky top-0 z-40 hidden bg-[#1c1c1c] text-white lg:block" aria-label="Navigare principală">
  <ul class="wrap lg:flex">
    {meniu.map((l) => (
      <li><a href={l.href} class="block border-b border-white/10 px-0 py-3 text-[0.95rem] font-medium no-underline hover:text-gold-bright lg:border-0 lg:px-4 lg:py-3.5 lg:first:pl-0">{l.label}</a></li>
    ))}
  </ul>
</nav>

<div class="bg-gold-bright text-[#151515]">
  <div class="wrap flex items-center gap-x-6 overflow-x-auto whitespace-nowrap py-2 text-[0.9rem]">
    <strong>Cumpărăm aur azi:</strong>
    {preturi.cumparare.filter((p) => p.carat !== "9K").map((p) => (
      <span>{p.carat} <strong>{p.leiGram} lei/g</strong></span>
    ))}
    <a href={u("/cumparam-aur")} class="font-bold underline underline-offset-2">Calculați cât primiți</a>
  </div>
</div>

<style>
  .bifa { width: 14px; height: 14px; border-radius: 50%; background: var(--color-gold-bright); position: relative; flex: none; }
  .bifa::after { content: ""; position: absolute; left: 4px; top: 2px; width: 4px; height: 7px; border: solid #000; border-width: 0 2px 2px 0; transform: rotate(45deg); }

  .logo { display: grid; grid-template-columns: auto auto; column-gap: 0.4rem; align-items: center; justify-content: start; text-decoration: none; line-height: 1; }
  .logo-nume { font-size: 1.5rem; font-weight: 900; letter-spacing: 0.01em; }
  .logo-marcaj { font-size: 1.15rem; font-weight: 900; padding: 0.2rem 0.4rem; background: var(--color-gold-bright); border: 2px solid #151515; }
  .logo-sub { grid-column: 1 / -1; margin-top: 0.3rem; font-size: 0.72rem; color: var(--color-ink-soft); white-space: nowrap; }
</style>

<script>
  const btn = document.getElementById("meniu-btn");
  const meniu = document.getElementById("meniu");
  btn?.addEventListener("click", () => {
    const deschis = meniu?.classList.toggle("hidden") === false;
    btn.setAttribute("aria-expanded", String(deschis));
  });
</script>
