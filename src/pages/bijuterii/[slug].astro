---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import Card from "../../components/Card.astro";
import IconWa from "../../components/IconWa.astro";
import { img } from "../../data/img";
import { site, u, waLink, lei, grame } from "../../data/site";
import { bijuterii, provenienteInfo, categoriiInfo, pretPeGram, titluPiesa, masuri, type Piesa } from "../../data/bijuterii";

export function getStaticPaths() {
  return bijuterii.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props as { p: Piesa };
const prov = provenienteInfo[p.provenienta];
const t = titluPiesa(p);
const similare = bijuterii.filter((b) => b.slug !== p.slug && b.categorie === p.categorie).slice(0, 4);
const mesaj = `Bună ziua! Mă interesează piesa ${p.cod} (${p.nume}, ${grame(p.gramaj)}, ${lei(p.pret)}). Mai este disponibilă?`;
---

<Layout title={`${p.nume}, aur ${t.carat}, ${grame(p.gramaj)} · ${site.nume}`} description={`${p.nume} din aur de ${t.carat}, ${grame(p.gramaj)}. ${prov.eticheta}. ${p.descriere}`}>
  <div class="wrap pt-6 pb-20 md:pt-8">
    <nav aria-label="Fir de navigare" class="text-[0.92rem] text-ink-soft">
      <a href={u("/bijuterii")} class="hover:text-ink">Bijuterii</a>
      <span aria-hidden="true"> / </span>
      <a href={u(`/bijuterii?categorie=${p.categorie}`)} class="hover:text-ink">{categoriiInfo[p.categorie]}</a>
    </nav>

    <div class="mt-5 grid gap-8 lg:grid-cols-[1.05fr_1fr] lg:gap-14">
      <Image src={img(p.img)} alt={p.alt} width={1000} height={1000} loading="eager" class="aspect-square w-full border border-line bg-paper-2 object-cover" />

      <div>
        <p class="inline-block bg-[#151515] px-2 py-0.5 text-[0.82rem] font-bold text-white">{prov.eticheta}</p>
        <h1 class="mt-3 !text-[clamp(1.5rem,1.2rem+1.2vw,2.1rem)]">{p.nume}</h1>
        <p class="mt-4 text-[2.1rem] font-bold leading-none">
          {p.pretVechi && <s class="mr-3 text-[1.1rem] font-normal text-ink-soft">{lei(p.pretVechi)}</s>}
          {p.deLa && <span class="text-[1.1rem] font-medium text-ink-soft">de la </span>}{lei(p.pret)}
        </p>
        <p class="mt-5 text-ink-soft">{p.descriere}</p>

        <dl class="mt-6 border-t border-ink cifra">
          <div class="rand"><dt>Cod piesă</dt><dd>{p.cod}</dd></div>
          <div class="rand"><dt>Titlu</dt><dd>{t.carat}, marcaj {t.marcaj}</dd></div>
          <div class="rand"><dt>Greutate</dt><dd>{grame(p.gramaj)}</dd></div>
          {masuri(p).map((m) => <div class="rand"><dt>{m.eticheta}</dt><dd>{m.valoare}</dd></div>)}
          <div class="rand"><dt>Preț pe gram</dt><dd>{pretPeGram(p)} lei/g</dd></div>
          <div class="rand"><dt>Stare</dt><dd class="max-w-[62%] !font-medium">{p.stare}</dd></div>
        </dl>

        <a href={waLink(mesaj)} target="_blank" rel="noopener" class="btn btn-wa mt-6 w-full !min-h-12 !text-base sm:w-auto"><IconWa /> Întrebați de piesa {p.cod}</a>
        <a href={`tel:${site.telefon}`} class="btn btn-line mt-2 w-full !min-h-12 sm:ml-2 sm:mt-6 sm:w-auto">Sunați: {site.telefonAfisat}</a>
        <p class="mt-4 text-[0.95rem] text-ink-soft">
          {p.provenienta === "nou"
            ? "Se lucrează în 10 – 14 zile de la confirmare. Prețul final se calculează pe gramajul piesei terminate."
            : "Este un singur exemplar. Vă trimitem poze și clip cu piesa pe cântar, apoi o putem rezerva 48 de ore."}
        </p>
      </div>
    </div>

    {similare.length > 0 && (
      <section class="mt-14">
        <h2>Alte {categoriiInfo[p.categorie].toLowerCase()}</h2>
        <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-4 md:gap-4">
          {similare.map((s) => <Card piesa={s} />)}
        </div>
      </section>
    )}
  </div>
</Layout>
