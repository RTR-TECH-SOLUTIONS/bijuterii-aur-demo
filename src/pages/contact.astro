---
import Layout from "../layouts/Layout.astro";
import IconWa from "../components/IconWa.astro";
import { site, waLink } from "../data/site";
---

<Layout title={`Contact · ${site.nume}`} description={`Scrieți-ne pe WhatsApp la ${site.telefonAfisat} pentru bijuterii din aur de 14K sau pentru a vinde aur.`}>
  <section class="wrap grid gap-12 pt-8 pb-16 md:pt-10 lg:grid-cols-[1fr_1fr] lg:gap-20">
    <div>
      <h1 class="!text-[clamp(1.7rem,1.3rem+1.6vw,2.4rem)]">Contact</h1>
      <p class="mt-5 max-w-lg text-[1.1rem] text-ink-soft">
        Cel mai repede ne găsiți pe WhatsApp. Răspundem în timpul programului, de obicei în mai puțin de o oră.
      </p>
      <a href={`tel:${site.telefon}`} class="mt-8 block text-[clamp(2rem,1.5rem+2.5vw,3.25rem)] font-bold leading-none tracking-tight cifra no-underline hover:text-red">{site.telefonAfisat}</a>
      <a href={waLink("Bună ziua!")} target="_blank" rel="noopener" class="btn btn-wa mt-5"><IconWa /> Deschideți WhatsApp</a>

      <dl class="mt-10 max-w-sm border-t border-ink cifra">
        {site.program.map((p) => <div class="rand"><dt>{p.zi}</dt><dd>{p.ore}</dd></div>)}
      </dl>
      <p class="mt-5 max-w-md text-[0.95rem] text-ink-soft">
        Nu avem încă un sediu deschis publicului. Piesele se văd în poze și clipuri reale, iar predarea se face prin curier sau personal.
      </p>
    </div>

    <form id="mesaj" class="self-start rounded-(--radius-box) border border-line bg-white p-6 md:p-8" data-wa={site.whatsapp} novalidate>
      <h2 class="!text-[1.5rem]">Scrieți mesajul aici</h2>
      <p class="mt-1.5 text-[0.95rem] text-ink-soft">Se deschide WhatsApp cu textul completat. Îl trimiteți dumneavoastră.</p>
      <div class="mt-6 grid gap-4">
        <label class="block"><span class="mb-1.5 block text-[0.95rem] font-medium">Numele dumneavoastră</span>
          <input class="camp" name="nume" autocomplete="name" required />
        </label>
        <label class="block"><span class="mb-1.5 block text-[0.95rem] font-medium">Despre ce este vorba</span>
          <select class="camp" name="subiect">
            <option>Vreau să cumpăr o bijuterie</option>
            <option>Vreau o bijuterie nouă, la comandă</option>
            <option>Am aur de vândut</option>
            <option>Altceva</option>
          </select>
        </label>
        <label class="block"><span class="mb-1.5 block text-[0.95rem] font-medium">Mesaj</span>
          <textarea class="camp" name="mesaj" rows="4" required placeholder="De exemplu: caut un lanț bărbătesc de 55 cm, în jur de 15 g."></textarea>
        </label>
      </div>
      <p id="eroare" class="mt-3 hidden text-[0.95rem] font-medium text-[#9a1c12]" role="alert">Completați numele și mesajul.</p>
      <button type="submit" class="btn btn-ink mt-5 w-full">Continuați în WhatsApp</button>
    </form>
  </section>
</Layout>

<script>
  const f = document.getElementById("mesaj") as HTMLFormElement | null;
  f?.addEventListener("submit", (e) => {
    e.preventDefault();
    const d = new FormData(f);
    const nume = String(d.get("nume")).trim(), mesaj = String(d.get("mesaj")).trim();
    const eroare = document.getElementById("eroare")!;
    if (!nume || !mesaj) { eroare.classList.remove("hidden"); return; }
    eroare.classList.add("hidden");
    // TODO(real): pe lângă WhatsApp, mesajul se poate trimite și pe e-mail (Resend)
    const text = `Bună ziua! Sunt ${nume}. ${d.get("subiect")}. ${mesaj}`;
    window.open(`https://wa.me/${f.dataset.wa}?text=${encodeURIComponent(text)}`, "_blank", "noopener");
  });
</script>
